# Quartus build output. All of this is regenerated by quartus_map / quartus_fit
# from the sources, the .qsf and the .sdc, so none of it belongs in history.
# Note that db/ was committed before this file existed; those entries stay
# tracked until they are explicitly removed with `git rm -r --cached db`.
db/
incremental_db/
output_files/
greybox_tmp/
simulation/
.qsys_edit/
*.qws
*.rpt
*.summary
*.sof
*.pof
*.jdi
*.pin
*.smsg
*.done
c5_pin_model_dump.txt
cr_ie_info.json

# ModelSim. sim/run.sh builds outside the tree, but a hand-run vlog/vsim in the
# repo root leaves these behind.
work/
transcript
vsim.wlf
*.vstf
modelsim.ini

# Generated ROM images (.hex and .mif alike) are deliberately NOT ignored. rom/*.hex is an input to
# synthesis via $readmemh, so tracking it keeps the bitstream reproducible
# without requiring Python to regenerate it first.

# Python bytecode from the tools in tools/.
__pycache__/
*.pyc

# Your own MS-DOS media. Proprietary Microsoft software: fine to use on your
# own board, not something to commit or redistribute from this repo.
ms-dos/

# A BIOS built with --fast-tick for sim/tb_msdos.sv only. It must never be
# synthesised, so it is not kept in the tree.
rom/fast/
